# 교사 로그인(Vercel 서버 전용 환경변수) — 이 파일은 이름만 보여 주는 예시입니다. 값은 비워 둡니다.
# 실제 값은 Vercel → Project → Settings → Environment Variables에 넣고,
# 로컬 확인용은 `npm run teacher:setup -- --write-local`로 .env.local(git 제외)에 만듭니다.

# 필수: 비밀번호 검증값(scrypt). `npm run teacher:setup`으로 만든 값. 비밀번호 자체를 넣지 않습니다.
TEACHER_PASSWORD_HASH=
# 필수: 세션 서명용 비밀키(32자 이상 무작위 값). `npm run teacher:setup`이 함께 만들어 줍니다.
TEACHER_SESSION_SECRET=
# 선택: 로그인 유지 시간(시간 단위, 1~24, 기본 8)
TEACHER_SESSION_HOURS=

# 선택(권장): 서버 저장소 Upstash Redis — 로그인 시도 제한을 모든 서버 인스턴스에서 공유,
# 로그아웃한 세션 무효화, 교사 설정·메모를 서버에 보관. Vercel Marketplace의 Upstash 연결 시 자동으로 들어갑니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
