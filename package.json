{
  "name": "tide-data-lab",
  "version": "1.0.0",
  "private": true,
  "description": "조석 데이터 탐구실 — 고등학교 지구과학 수행평가용 조석 자료 분석·보고서 웹앱",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs",
    "teacher:setup": "node tools/teacher-auth-setup.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\" \"tests/khoa/*.test.mjs\"",
    "test:e2e": "node tests/e2e/run-e2e.mjs && node tests/e2e/assessment-e2e.mjs",
    "make-sample": "node tools/make-sample-data.mjs",
    "khoa:test-day": "node tools/khoa/collect.mjs --test-day 2022-09-01",
    "khoa:collect": "node tools/khoa/collect.mjs --start 2022-09-01 --end 2022-09-30",
    "khoa:build": "node tools/khoa/build-case.mjs --start 2022-09-01 --end 2022-09-30",
    "weather:test-day": "node tools/khoa/collect.mjs --test-day 2022-09-01 --datasets airpress,wind,asos",
    "weather:collect": "node tools/khoa/collect.mjs --start 2022-09-01 --end 2022-09-30 --datasets airpress,wind,asos",
    "kma:typhoon": "node tools/kma/typhoon.mjs --year 2022 --no 11",
    "kma:station": "node tools/kma/station-info.mjs --stn 159",
    "stations:fetch": "node tools/khoa/stations.mjs fetch && node tools/kma/asos-stations.mjs",
    "stations:plan": "node tools/khoa/stations.mjs plan",
    "multi:collect": "node tools/khoa/collect.mjs --plan data/stations/plan.json --datasets hourly,forecast,airpress,wind,asos",
    "multi:test-day": "node tools/khoa/collect.mjs --plan data/stations/plan.json --datasets hourly,forecast,airpress,wind,asos --test-day 2022-09-01",
    "multi:build": "node tools/khoa/build-multi.mjs --case-id khoa-multi-2022-09"
  },
  "license": "UNLICENSED"
}
